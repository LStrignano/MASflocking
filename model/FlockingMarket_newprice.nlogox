    <button x="94" y="21" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="55">go</button>
    <chooser x="372" y="535" height="60" variable="scenario" current="6" width="100" display="scenario">
      <choice type="string" value="bull-market"></choice>
      <choice type="string" value="bear-market"></choice>
      <choice type="string" value="crash"></choice>
      <choice type="string" value="sideways"></choice>
      <choice type="string" value="bubble"></choice>
      <choice type="string" value="api-live"></choice>
      <choice type="string" value="csv"></choice>
    </chooser>
    <input x="373" multiline="false" y="607" height="60" variable="num-days" type="number" width="100">700.0</input>
    <monitor x="789" precision="17" y="535" height="60" fontSize="11" width="100" display="Total BTC">total-bitcoin</monitor>
