<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="false">
  <code><![CDATA[extensions [ csv ]

;; ============================================================
;; PARAMETRI (sliders/chooser nell'interfaccia)
;;   Popolazione:   population-a, population-b, population-c, number-of-followers
;;   Corrente:      k (x = k*volatilita'), h (y = +-h*rendimento)
;;   Moto:          temperature, velocity-damping, repulsion-radius, repulsion-strength, spawn-radius
;;   Scambi:        trade-size, trade-interval
;;   Prezzo:        price-sensitivity (mu), scenario, num-days
;;   Hype:          hype-sensitivity, hype-persistence (rho), drawdown-weight (w)
;;   Switch fase:   pearson-threshold, window-size, min-ticks-above, force-phase2-day
;; ============================================================

breed [ agents-a agent-a ]   ;; trend follower   (y = +h*r)
breed [ agents-b agent-b ]   ;; contrarian        (y = -h*r)
breed [ agents-c agent-c ]   ;; neutri            (y = 0)

globals [
  ;; dati reali
  prices
  day-index
  btc-price
  btc-return
  btc-volatility
  real-trading-volume-usd

  ;; modello
  model-price
  model-ath-price
  model-return
  model-volatility
  model-trading-volume
  model-net-flow
  last-excess-demand

  ;; fase e hype
  endogenous-phase?
  current-hype
  hype-memory

  ;; correlazione volumi (criterio di switch)
  model-volume-history
  real-volume-history
  volume-correlation
  volume-correlation-history
  mean-volume-correlation
  above-threshold-counter

  ;; correlazione rendimenti (diagnostica)
  model-return-history
  real-return-history
  return-correlation
  return-correlation-history
  mean-return-correlation
]

turtles-own [
  flockmates
  bitcoin-held
  cash-balance
  velocity-x
  velocity-y
]


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; UTILITA'
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to assicura-penna [ nome-penna colore ]
  carefully [
    set-current-plot-pen nome-penna
  ] [
    create-temporary-plot-pen nome-penna
    set-plot-pen-color colore
  ]
end

;; aggiunge un valore a una lista mantenendo al massimo window-size elementi
to-report push-window [ lst value ]
  let new-lst lput value lst
  if length new-lst > window-size [ set new-lst but-first new-lst ]
  report new-lst
end

to-report pearson-correlation [ xs ys ]
  let n length xs
  if n < 2 [ report 0 ]
  let mean-x mean xs
  let mean-y mean ys
  let cov sum (map [ [x y] -> (x - mean-x) * (y - mean-y) ] xs ys)
  let sx sqrt sum (map [ x -> (x - mean-x) ^ 2 ] xs)
  let sy sqrt sum (map [ y -> (y - mean-y) ^ 2 ] ys)
  if (sx = 0) or (sy = 0) [ report 0 ]
  report cov / (sx * sy)
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; SETUP
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to inizializza-agente [ colore ]
  set color colore
  set size 40
  let angolo random-float 360
  let raggio random-float spawn-radius
  setxy (raggio * cos angolo) (raggio * sin angolo)
  set heading random 360
  set velocity-x sin heading
  set velocity-y cos heading
  set flockmates no-turtles
  set bitcoin-held random 6
  set cash-balance 50000 + random 1450001
end

to setup
  clear-all

  carefully [ import-drawing "grafico_buy_sell.png" ] [ ]

  if not is-number? pearson-threshold [ set pearson-threshold 0.5 ]
  if window-size < 2 [ set window-size 2 ]
  if trade-interval <= 0 [
    user-message "Attenzione: trade-interval deve essere > 0. Impostato a 1."
    set trade-interval 1
  ]

  set endogenous-phase? false
  set current-hype 0
  set hype-memory 0

  set day-index 0
  set btc-price 0
  set btc-return 0
  set btc-volatility 0
  set real-trading-volume-usd 0

  set model-price 0
  set model-ath-price btc-price
  set model-return 0
  set model-volatility 0
  set model-trading-volume 0
  set model-net-flow 0
  set last-excess-demand 0

  set model-volume-history []
  set real-volume-history []
  set volume-correlation 0
  set volume-correlation-history []
  set mean-volume-correlation 0
  set above-threshold-counter 0

  set model-return-history []
  set real-return-history []
  set return-correlation 0
  set return-correlation-history []
  set mean-return-correlation 0

  set prices []
  scarica-dati
  bilancia-portafogli

  create-agents-a population-a [ inizializza-agente yellow ]
  create-agents-b population-b [ inizializza-agente red ]
  create-agents-c population-c [ inizializza-agente cyan ]

  ;; rete fissa: ogni agente segue number-of-followers agenti della propria specie
  ask turtles [
    let my-breed breed
    let candidati other turtles with [ breed = my-breed ]
    let n min (list number-of-followers (count candidati))
    if n > 0 [ set flockmates n-of n candidati ]
  ]

  ;; primo giorno reale
  if length prices > 0 [
    let record item 0 prices
    set btc-price item 1 record
    set real-trading-volume-usd item 2 record
    set day-index 1
  ]

  set model-price btc-price
  set model-ath-price btc-price

  print "=== SETUP COMPLETATO - FASE 1 (prezzo reale) ==="
  reset-ticks
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; GO
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to go
  if day-index >= length prices [ stop ]   ;; dati finiti

  set model-trading-volume 0
  let trade-tick? (ticks mod trade-interval = 0)

  ;; 1. dati reali e prezzo del modello
  if trade-tick? [
    if ticks > 0 [ aggiorna-dati ]
    aggiorna-prezzo-modello
    set model-net-flow 0      ;; il flusso e' stato usato: riparte da zero
  ]

  ;; 2. hype (una sola chiamata per tick) e movimento
  set current-hype calcola-hype

  ask turtles [
    flock
    repel-different-breeds
    swim
  ]

  ;; 3. scambi, correlazioni, switch, plot
  if trade-tick? [
    ask turtles [ compravendita-bitcoin ]
    aggiorna-storico-volumi
    aggiorna-correlazione-rendimenti
    controlla-switch
    aggiorna-plot
  ]

  tick
end

to bilancia-portafogli
  ask turtles [
    let w0 initial-wealth-btc * (0.5 + random-float 1)      ;; eterogeneita' +-50%
    set cash-balance (w0 / 2) * model-price                  ;; meta' in contanti
    set bitcoin-held max (list 1 round (w0 / 2))             ;; meta' in BTC
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; PREZZO DEL MODELLO
;;   Fase 1: copia del prezzo reale
;;   Fase 2: ln p_{t+1} = ln p_t + mu * D_t,
;;           D_t = (acquisti - vendite) / (N * trade-size)  in [-1, 1]
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to aggiorna-prezzo-modello

  if count turtles > 0 [
    set last-excess-demand model-net-flow / (count turtles * trade-size)
  ]

  ifelse not endogenous-phase? [
    set model-price btc-price
    set model-return btc-return
    set model-volatility btc-volatility
  ] [
    if count turtles > 0 [
      let prev-m-price model-price
      set model-price max (list 1 (prev-m-price * exp (price-sensitivity * last-excess-demand)))
      set model-return (model-price - prev-m-price) / prev-m-price
      set model-volatility max (list 0.005 (abs model-return))
    ]
  ]

  if model-price > model-ath-price [ set model-ath-price model-price ]
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; HYPE CON MEMORIA E STUBBORNNESS
;;   H_t = max( |r| + sigma + w*DD , rho * H_{t-1} )
;;   stubbornness = 0.95 - hype-sensitivity * H   (limitata a [0.05, 0.95])
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to-report calcola-hype
  let drawdown max (list 0 ((model-ath-price - model-price) / max (list 1 model-ath-price)))
  let raw-hype (abs model-return) + model-volatility + (drawdown)
  set hype-memory max (list raw-hype (hype-persistence * hype-memory))
  report hype-memory
end

to-report dynamic-stubbornness
  let base-s 0.95
  let min-s 0.05
  let raw-s base-s - (hype-sensitivity * current-hype)
  report max (list min-s (min (list base-s raw-s)))
end

to-report v0
  report 4
end

to-report self-prop
  report 0.05
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; CORRENTE (identica nelle due fasi: usa model-*, che in Fase 1 = dati reali)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to-report my-current-x
  report k * model-volatility
end

to-report my-current-y
  ifelse breed = agents-a [
    report h * model-return
  ] [
    ifelse breed = agents-b [
      report (- h * model-return)
    ] [
      report 0
    ]
  ]
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; MOVIMENTO
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to-report unit-vx
  let sp sqrt (velocity-x ^ 2 + velocity-y ^ 2)
  ifelse sp > 0 [ report velocity-x / sp ] [ report 0 ]
end

to-report unit-vy
  let sp sqrt (velocity-x ^ 2 + velocity-y ^ 2)
  ifelse sp > 0 [ report velocity-y / sp ] [ report 0 ]
end

to flock
  if any? flockmates [
    let s dynamic-stubbornness
    let my-speed sqrt (velocity-x ^ 2 + velocity-y ^ 2)

    if my-speed > 0 [
      let avg-ux mean [ unit-vx ] of flockmates
      let avg-uy mean [ unit-vy ] of flockmates

      let wx (s * unit-vx) + ((1 - s) * avg-ux)
      let wy (s * unit-vy) + ((1 - s) * avg-uy)
      let wn sqrt (wx ^ 2 + wy ^ 2)

      if wn > 0 [
        set velocity-x my-speed * wx / wn
        set velocity-y my-speed * wy / wn
      ]
    ]
  ]
end

to repel-different-breeds
  let my-breed breed
  let vicini-diversi other turtles in-radius repulsion-radius with [ breed != my-breed ]

  if any? vicini-diversi [
    let rx sum [ ([xcor] of myself - xcor) / ((distance myself) ^ 2 + 0.01) ] of vicini-diversi
    let ry sum [ ([ycor] of myself - ycor) / ((distance myself) ^ 2 + 0.01) ] of vicini-diversi

    if not (rx = 0 and ry = 0) [
      set heading atan rx ry
      fd repulsion-strength
    ]
  ]
end

to swim
   set velocity-x (velocity-x * (1 - velocity-damping)) + my-current-x - restoring-strength * (xcor / max-pxcor)
  set velocity-y (velocity-y * (1 - velocity-damping)) + my-current-y - restoring-strength * (ycor / max-pycor)

  let next-x xcor + velocity-x
  let next-y ycor + velocity-y

  if next-x > max-pxcor or next-x < min-pxcor [
    set velocity-x (- velocity-x)
    set next-x max (list min-pxcor (min (list max-pxcor next-x)))
  ]
  if next-y > max-pycor or next-y < min-pycor [
    set velocity-y (- velocity-y)
    set next-y max (list min-pycor (min (list max-pycor next-y)))
  ]

  setxy next-x next-y

  ;; rumore: rotazione casuale della velocita'
  let random-angle random-float (2 * temperature) - temperature
  let old-vx velocity-x
  let old-vy velocity-y
  set velocity-x (old-vx * cos random-angle) - (old-vy * sin random-angle)
  set velocity-y (old-vx * sin random-angle) + (old-vy * cos random-angle)

  if velocity-x != 0 or velocity-y != 0 [
    set heading atan velocity-x velocity-y
  ]
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; COMPRAVENDITA
;;   y >= 0 compra, y < 0 vende; la probabilita' dipende da x
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to-report probabilita-scambio
  let ampiezza-x (max-pxcor - min-pxcor)
  if ampiezza-x = 0 [ report 0 ]
  let p ((xcor - min-pxcor) / ampiezza-x)
  report min (list 1 (max (list 0 p)))
end

to compravendita-bitcoin
  let current-p model-price

  if current-p > 0 [
    let p probabilita-scambio
    let quantita-acquisto min (list trade-size (floor (cash-balance / current-p)))
    let quantita-vendita  min (list trade-size bitcoin-held)

    ifelse ycor >= 0 [
      if (random-float 1 < p) and (quantita-acquisto > 0) [
        set cash-balance cash-balance - (quantita-acquisto * current-p)
        set bitcoin-held bitcoin-held + quantita-acquisto
        set model-trading-volume model-trading-volume + quantita-acquisto
        set model-net-flow model-net-flow + quantita-acquisto
      ]
    ] [
      if (random-float 1 < p) and (quantita-vendita > 0) [
        set bitcoin-held bitcoin-held - quantita-vendita
        set cash-balance cash-balance + (quantita-vendita * current-p)
        set model-trading-volume model-trading-volume + quantita-vendita
        set model-net-flow model-net-flow - quantita-vendita
      ]
    ]
  ]
end

to-report model-trading-volume-usd
  report model-trading-volume * max (list 0 model-price)
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; DATI REALI
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to aggiorna-dati
  if day-index >= length prices [ stop ]

  let record item day-index prices
  let new-price item 1 record
  set real-trading-volume-usd item 2 record

  ifelse btc-price > 0 [
    set btc-return (new-price - btc-price) / btc-price
    set btc-volatility abs btc-return
  ] [
    set btc-return 0
    set btc-volatility 0
  ]

  set btc-price new-price
  set day-index day-index + 1
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; CORRELAZIONI
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to aggiorna-storico-volumi
  if real-trading-volume-usd > 0 [
    set model-volume-history push-window model-volume-history model-trading-volume-usd
    set real-volume-history  push-window real-volume-history  real-trading-volume-usd

    if length model-volume-history >= 2 [
      set volume-correlation pearson-correlation model-volume-history real-volume-history
      set volume-correlation-history push-window volume-correlation-history volume-correlation
      set mean-volume-correlation mean volume-correlation-history
    ]
  ]
end

to aggiorna-correlazione-rendimenti
  set model-return-history push-window model-return-history model-return
  set real-return-history  push-window real-return-history  btc-return

  if length model-return-history >= 2 [
    set return-correlation pearson-correlation model-return-history real-return-history
    set return-correlation-history push-window return-correlation-history return-correlation
    set mean-return-correlation mean return-correlation-history
  ]
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; SWITCH FASE 1 -> FASE 2
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to controlla-switch
  if endogenous-phase? [ stop ]

  if force-phase2-day > 0 and day-index >= force-phase2-day [
    passa-a-fase-2
    stop
  ]

  if length model-volume-history >= window-size [
    ifelse mean-volume-correlation >= pearson-threshold [
      set above-threshold-counter above-threshold-counter + 1
    ] [
      set above-threshold-counter 0
    ]

    if above-threshold-counter > min-ticks-above [
      passa-a-fase-2
    ]
  ]
end

to passa-a-fase-2
  set endogenous-phase? true
  print (word "!!! FASE 2 (prezzo endogeno) al giorno " day-index
              " | r medio volumi = " precision mean-volume-correlation 3)
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; SCENARI (volume sintetico = 0: usare force-phase2-day per lo switch)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to scarica-dati
  if scenario = "csv" [ carica-dati-da-csv "dati_btc.csv" stop ]
  if scenario = "crash" [ set prices genera-crash 60000 stop ]
  if scenario = "bull-market" [ set prices genera-prezzi 30000 0.015 0.01 stop ]
  if scenario = "bear-market" [ set prices genera-prezzi 60000 -0.015 0.01 stop ]
  if scenario = "sideways" [ set prices genera-prezzi 40000 0 0.005 stop ]
  if scenario = "bubble" [ set prices genera-bolla 30000 stop ]
end

to carica-dati-da-csv [ nome-file ]
  set prices []
  file-close-all

  carefully [
    let dati csv:from-file nome-file

    if length dati > 0 [
      let prima-riga item 0 dati
      if not is-number? item 1 prima-riga [ set dati but-first dati ]
    ]

    let t 0
    foreach dati [ riga ->
      if length riga >= 2 [
        let p item 1 riga
        if is-number? p [
          let vol 0
          if length riga >= 3 [
            if is-number? item 2 riga [ set vol item 2 riga ]
          ]
          set prices lput (list t p vol) prices
          set t t + 1
        ]
      ]
    ]

    print (word "CSV caricato: " length prices " record validi.")
  ] [
    file-close-all
    user-message (word "Errore nella lettura del file CSV: " nome-file)
  ]
end

to-report genera-prezzi [ prezzo-iniziale drift sigma ]
  let result []
  let p prezzo-iniziale
  let t 0
  while [ t < num-days ] [
    let r drift + random-normal 0 sigma
    set p max (list 1 (p * (1 + r)))
    set result lput (list t p 0) result
    set t t + 1
  ]
  report result
end

to-report genera-crash [ prezzo-iniziale ]
  let result []
  let p prezzo-iniziale
  let t 0
  while [ t < num-days ] [
    let r 0
    ifelse t < 100 [
      set r random-normal 0 0.005
    ] [
      ifelse t < 110 [
        set r -0.25 + random-normal 0 0.02
      ] [
        set r random-normal 0.003 0.012
      ]
    ]
    set p max (list 1 (p * (1 + r)))
    set result lput (list t p 0) result
    set t t + 1
  ]
  report result
end

to-report genera-bolla [ prezzo-iniziale ]
  let result []
  let p prezzo-iniziale
  let t 0
  while [ t < num-days ] [
    let r 0
    ifelse t < 100 [
      set r 0.025 + random-normal 0 0.008
    ] [
      ifelse t < 110 [
        set r 0.08 + random-normal 0 0.02
      ] [
        ifelse t < 115 [
          set r -0.3 + random-normal 0 0.025
        ] [
          set r -0.002 + random-normal 0 0.015
        ]
      ]
    ]
    set p max (list 1 (p * (1 + r)))
    set result lput (list t p 0) result
    set t t + 1
  ]
  report result
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; PLOT (stessi nomi dell'interfaccia attuale)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to aggiorna-plot
  carefully [
    set-current-plot "Prezzo BTC (USD)"
    assicura-penna "prezzo-reale" blue
    plotxy day-index btc-price
    assicura-penna "prezzo-stimato" red
    plotxy day-index model-price

    set-current-plot "Volume BTC (USD)"
    assicura-penna "modello-usd" green
    plotxy day-index model-trading-volume-usd
    if real-trading-volume-usd > 0 [
      assicura-penna "reale-usd" gray
      plotxy day-index real-trading-volume-usd
    ]

    set-current-plot "Correlazione Volumi (Pearson r)"
    assicura-penna "soglia-switch" red
    plotxy day-index pearson-threshold
    assicura-penna "zero" black
    plotxy day-index 0
    if real-trading-volume-usd > 0 [
      assicura-penna "correlazione" blue
      plotxy day-index volume-correlation
      assicura-penna "correlazione-media" green
      plotxy day-index mean-volume-correlation
    ]

    set-current-plot "Correlazione Prezzi (Pearson r)"
    assicura-penna "zero" black
    plotxy day-index 0
    assicura-penna "correlazione" orange
    plotxy day-index return-correlation
    assicura-penna "correlazione-media" magenta
    plotxy day-index mean-return-correlation
  ] [
    print error-message
  ]
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; REPORTER PER MONITOR
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to-report order-parameter-of [ agenti-selezionati ]
  if count agenti-selezionati = 0 [ report 0 ]
  let sx sum [ dx ] of agenti-selezionati
  let sy sum [ dy ] of agenti-selezionati
  report (sqrt (sx ^ 2 + sy ^ 2)) / count agenti-selezionati
end

to-report order-parameter
  report order-parameter-of turtles
end

to-report order-parameter-a
  report order-parameter-of agents-a
end

to-report order-parameter-b
  report order-parameter-of agents-b
end

to-report order-parameter-c
  report order-parameter-of agents-c
end

to-report total-bitcoin
  report sum [ bitcoin-held ] of turtles
end

to-report total-cash
  report sum [ cash-balance ] of turtles
end

to-report bitcoin-a
  report sum [ bitcoin-held ] of agents-a
end

to-report bitcoin-b
  report sum [ bitcoin-held ] of agents-b
end

to-report bitcoin-c
  report sum [ bitcoin-held ] of agents-c
end

to-report mean-y-a
  if count agents-a = 0 [ report 0 ]
  report mean [ ycor ] of agents-a
end

to-report mean-y-b
  if count agents-b = 0 [ report 0 ]
  report mean [ ycor ] of agents-b
end]]></code>
  <widgets>
    <view x="373" wrappingAllowedX="false" y="35" frameRate="144.0" minPycor="-1000" height="490" showTickCounter="true" patchSize="0.243" fontSize="10" wrappingAllowedY="false" width="490" tickCounterLabel="ticks" maxPycor="1000" updateMode="0" maxPxcor="1000" minPxcor="-1000"></view>
